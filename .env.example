# Copy to .env.local (git-ignored).

# Base URL of the backend API. Leave EMPTY (also on Vercel) to call /api on the same origin:
# locally the Vite proxy forwards it to the local backend, on Vercel vercel.json forwards it to the Oracle backend.
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Currency used to display consultation fees (ISO 4217) and locale for formatting.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
