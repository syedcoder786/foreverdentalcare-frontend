# Copy to .env.local (git-ignored).

# Base URL of the backend API. Leave EMPTY to call /api on the same origin
# (recommended: Vite dev proxy locally, reverse proxy in production).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Currency used to display consultation fees (ISO 4217) and locale for formatting.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
